# Pastas de trabalho. Aceita caminho do Windows (C:\...) ou do WSL (/mnt/c/...).
# Se não definidas, usa ./data/input, ./data/output e ./data/downloads.
RPA_INPUT_DIR=C:\Users\SEU_USUARIO\RPA\input
RPA_OUTPUT_DIR=C:\Users\SEU_USUARIO\RPA\output
RPA_DOWNLOAD_DIR=C:\Users\SEU_USUARIO\RPA\downloads

# Navegador
# chrome = Chrome instalado na máquina (perfil persistente) | chromium = Chromium do Playwright
BROWSER_CHANNEL=chrome
# Pasta do perfil do Chrome usado pelo RPA (cookies/logins). Padrão: ./data/chrome-profile
# CHROME_PROFILE_DIR=
# Executável do Chrome. Padrão: C:\Program Files\Google\Chrome\Application\chrome.exe
# CHROME_PATH=
HEADLESS=true
SLOW_MO=0
TIMEOUT_MS=30000

# Logs: trace | debug | info | warn | error
LOG_LEVEL=info

# Bling — usuário-robô (obrigatório: o login é feito por usuário/senha)
BLING_USER=
BLING_PASSWORD=
# Pasta padrão dos boletos em PDF. Padrão: ./data/boletos
# BLING_BOLETOS_DIR=C:\Users\SEU_USUARIO\RPA\boletos
