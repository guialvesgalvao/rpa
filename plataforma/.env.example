# Desenvolvimento local. Suba o banco com: docker compose -f plataforma/docker-compose.yml up -d --wait
# Copie para .env (ignorado pelo git). Em produção, as variáveis ficam no painel do Railway.
PORT=3001
HOST=::
DATABASE_URL=postgres://rpa:rpa@localhost:5433/rpa
# Chave do JWT (ao menos 32 bytes). Gere uma: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SEGREDO=
DATABASE_URL_TESTE=postgres://rpa:rpa@localhost:5433/rpa_teste

# Sincronização com o Bling (API v3, OAuth2, só leitura). Opcional: preencha as quatro ou deixe as quatro vazias
# (sem elas, as rotas do Bling respondem 503). Client Id e Client Secret vêm do app cadastrado na Área do Integrador.
BLING_CLIENT_ID=
BLING_CLIENT_SECRET=
# Precisa ser idêntico ao link de redirecionamento cadastrado no app do Bling.
BLING_REDIRECT_URI=http://localhost:3001/v1/bling/oauth/retorno
# Chave que cifra os tokens no banco (32 bytes em base64). Gere uma: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
BLING_CHAVE_TOKENS=
# Sincronização automática (agendador dentro da API): true liga, vazia ou false desliga (padrão). Exige as quatro acima.
BLING_SINCRONIZACAO_AUTOMATICA=
# Minutos entre o fim de um ciclo e o início do próximo (5 a 1440; padrão 15).
# BLING_INTERVALO_MINUTOS=15
# Dias entre duas sincronizações completas (1 a 30; padrão 3).
# BLING_COMPLETA_DIAS=3
